{
  "name": "controlplane-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Developer-first, self-hostable feature delivery and configuration management platform",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" --filter \"./sdks/*\" run build",
    "clean": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" --filter \"./sdks/*\" exec rimraf dist",
    "test": "vitest run",
    "test:unit": "vitest run index.test.ts",
    "test:integration": "vitest run integration",
    "test:contract": "vitest run contract",
    "test:compatibility": "vitest run compatibility",
    "test:load": "vitest run load",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r exec tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.1",
    "globals": "^15.15.0",
    "prettier": "^3.5.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5",
    "zod": "^3.24.2"
  }
}
